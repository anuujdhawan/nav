# Production Environment Variables
# Copy this file to .env and update with your actual values

# Environment
NODE_ENV=production

# Database Configuration
DATABASE_URL=mysql://username:password@localhost:3306/navigator_immigration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=navigator_immigration
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_secure_database_password

# Security Keys (Generate secure random strings)
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
ENCRYPTION_KEY=your_encryption_key_minimum_32_characters
CSRF_SECRET=your_csrf_secret_minimum_32_characters
SESSION_SECRET=your_session_secret_minimum_32_characters
COOKIE_SECRET=your_cookie_secret_minimum_32_characters

# Email Service Configuration
EMAIL_SERVICE_API_KEY=your_email_service_api_key
EMAIL_FROM=noreply@navigatorglobals.com

# Development-only override for contact form testing
# When set outside production, /api/send-email will deliver to this inbox
# instead of the recipient coming from the form payload.
CONTACT_TEST_RECIPIENT=

# reCAPTCHA Configuration
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# API Security
API_RATE_LIMIT=100
API_TIMEOUT=30000

# CORS Configuration
ALLOWED_ORIGINS=https://navigatorglobals.com

# Monitoring and Logging
LOG_LEVEL=warn
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# Stripe Configuration (Live Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_51TFFNn2HOflo4dUkyoqNCxbKub0pMSs9ghBDZXltlV9QSnbGxIiDcNrnTXK5ssFaHg7oegaMUJ07hY1haZ6kSPN300PcKc0xcx
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
NEXT_PUBLIC_BASE_URL=https://navigatorglobals.com

# Security Headers
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CSP_NONCE=random

# File Upload Security
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Session Configuration
SESSION_MAX_AGE=86400000
SESSION_SECURE=true
SESSION_HTTP_ONLY=true

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Development Only (Remove in production)
NEXT_PUBLIC_API_URL=https://navigatorglobals.com/api
NEXT_PUBLIC_SITE_URL=https://navigatorglobals.com
